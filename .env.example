GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBED_MODEL=all-MiniLM-L6-v2
# faiss (default, no server needed) or qdrant (needs the Docker container — see README)
VECTOR_BACKEND=faiss
QDRANT_URL=http://localhost:6333

# Optional: Langfuse tracing, self-hosted locally — see langfuse/docker-compose.yml
# (`docker compose up -d` from that folder spins up Langfuse + Postgres/ClickHouse/Redis/MinIO,
# with the project and API keys below auto-provisioned headlessly on first boot, no signup needed).
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
